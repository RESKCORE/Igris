# OpsPilot Backend Configuration

# Database (SQL — SQLite file by default; point DATABASE_URL at any SQL server to switch)
DATABASE_URL=sqlite:///./opspilot.db

# Safety & Execution Controls
MODE=simulation
ALLOW_LIVE=false
MAX_EXTERNAL_ACTIONS=20
# Sandbox mode sends every message here instead of true recipients (e.g. your Gmail)
SANDBOX_REDIRECT_TO=

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
DEV_AUTH_BYPASS=true
JWT_SECRET=change-me-in-production
ENV=dev

# OpenRouter / Free LLM Models
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free models on OpenRouter:
# - openrouter/google/gemini-2.0-flash-exp:free
# - openrouter/meta-llama/llama-3.3-70b-instruct:free
# - openrouter/deepseek/deepseek-chat:free
LLM_MODEL=openrouter/google/gemini-2.0-flash-exp:free
LLM_API_KEY=
USE_CACHED_PLANS=false

# Mail Integration — real email delivery (Gmail SMTP)
# Enable 2-Step Verification, create an App Password (https://myaccount.google.com/apppasswords),
# then set SMTP_USER/SMTP_PASS to your Gmail. Sandbox/live runs deliver to Gmail.
WEB3FORMS_ACCESS_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com

# Owner notifications: email the key-owner whenever a plan is created or approved.
OWNER_NOTIFY=true
OWNER_EMAIL=

# Google Sheets export (data page -> "Send to Sheets")
# Service-account JSON: either a file path or the JSON itself
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_TEST_ID=

# Telegram Messaging
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_TEST_ID=
